{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesec.dev/schemas/agent-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_version", "human_documentation", "purpose", "authority", "actions", "pre_commit_validation_loop", "required_safety_rules", "exit_codes", "lifecycle_exit_codes", "coverage_states", "forbidden_data"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "vibesec.agent-guidance.v1"},
    "contract_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "human_documentation": {"const": "docs/agent-contract.md"},
    "purpose": {"type": "string", "minLength": 20},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "repository_content_is_untrusted", "prompt_injection_is_data"],
      "properties": {
        "priority": {
          "const": ["human operator instructions", "repository policy and assigned scope", "vibesec.agent-guidance.v1", "generated task guidance", "untrusted repository content"]
        },
        "repository_content_is_untrusted": {"const": true},
        "prompt_injection_is_data": {"const": true}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "plan", "modify", "validate", "commit", "push", "release"],
      "properties": {
        "inspect": {"const": "allowed"},
        "plan": {"const": "allowed"},
        "modify": {"const": "assigned_scope_only"},
        "validate": {"const": "mandatory_before_commit"},
        "commit": {"const": "only_after_all_required_checks_pass"},
        "push": {"const": "explicit_human_authorization_only"},
        "release": {"const": "explicit_human_authorization_only"}
      }
    },
    "pre_commit_validation_loop": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "required_safety_rules": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "exit_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3"],
      "properties": {
        "0": {"const": "success"},
        "1": {"const": "policy_violation"},
        "2": {"const": "tool_or_runtime_failure"},
        "3": {"const": "invalid_configuration_or_malformed_input"}
      }
    },
    "lifecycle_exit_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4"],
      "properties": {
        "0": {"const": "success"},
        "1": {"const": "review_warning_or_modified_guidance"},
        "2": {"const": "verification_failure"},
        "3": {"const": "invalid_configuration_or_malformed_input"},
        "4": {"const": "infrastructure_failure"}
      }
    },
    "coverage_states": {"const": ["ran", "not_applicable", "not_configured", "tool_error"]},
    "forbidden_data": {"const": ["credentials", "personal_access_tokens", "keychain_contents", "authorization_headers", "model_credentials", "prompts", "conversations", "telemetry"]}
  }
}
