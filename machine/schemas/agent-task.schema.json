{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesec.dev/schemas/agent-task-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "human_documentation", "title", "objective", "scope", "allowed_actions", "prohibited_actions", "required_checks", "failure_handling", "required_evidence", "expected_output", "capability_requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "human_documentation": {"const": "docs/agent-task-pack.md"},
    "title": {"type": "string", "minLength": 5},
    "objective": {"type": "string", "minLength": 20},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_checks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "failure_handling": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "required_evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "expected_output": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "capability_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
