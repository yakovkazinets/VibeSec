{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yakovkazinets/VibeSec/machine/schemas/domain-catalog.schema.json",
  "title": "VibeSec v1 domain catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stable_id", "status", "summary", "source", "human_documentation", "members", "statuses"],
  "properties": {
    "schema_version": {"const": 1},
    "stable_id": {"type": "string", "pattern": "^vibesec\\.catalog\\.[a-z0-9-]+$"},
    "status": {"enum": ["stable", "experimental", "conditionally_enforced", "deprecated", "internal"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000},
    "human_documentation": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "members": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "statuses": {"type": "object", "maxProperties": 1000, "additionalProperties": {"enum": ["stable", "experimental", "conditionally_enforced", "deprecated", "internal"]}}
  }
}
