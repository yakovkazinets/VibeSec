#!/usr/bin/env python3
"""Portable VibeSec Guardian command-line entry point."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys
from typing import Sequence

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))
from vibesec.exit_codes import INFRASTRUCTURE_FAILURE, INVALID_INPUT, SUCCESS, VERIFICATION_FAILED  # noqa: E402
from vibesec.output import emit, envelope  # noqa: E402
from vibesec.portable import PortableExecutionError, load_support, platform_id, select_execution_mode  # noqa: E402
from vibesec.toolchain import (  # noqa: E402
    ToolchainError, default_cache_home, inspect_profile_cache, install_profile_tools,
    managed_toolchain_disclosure, prepare_managed_results_dir, validate_profile_tools,
)
from vibesec.version import VersionError, read_version  # noqa: E402

MAX_DIAGNOSTIC_BYTES = 64 * 1024


def _bounded(value: str) -> str:
    encoded = value.encode("utf-8", errors="replace")[:MAX_DIAGNOSTIC_BYTES]
    return encoded.decode("utf-8", errors="replace")


def _progress(message: str) -> None:
    sys.stderr.write(message + "\n")
    sys.stderr.flush()


def _run(command: Sequence[str], *, environment: dict[str, str] | None = None,
         working_directory: Path = ROOT, lifecycle: bool = False) -> tuple[int, str, str]:
    completed = subprocess.run(
        list(command), cwd=working_directory, env=environment, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30 * 60, check=False,
    )
    allowed_codes = {0, 1, 2, 3, 4} if lifecycle else {0, 1, 2, 3}
    fallback = INFRASTRUCTURE_FAILURE if lifecycle else VERIFICATION_FAILED
    code = completed.returncode if completed.returncode in allowed_codes else fallback
    # Standard output is the command's machine-readable result and must remain
    # complete. Only human-readable diagnostics are bounded.
    return code, completed.stdout, _bounded(completed.stderr)


def _passthrough(script: str, arguments: list[str]) -> int:
    code, stdout, stderr = _run(
        [sys.executable, str(ROOT / "scripts" / script), *arguments],
        lifecycle=True,
    )
    if stdout:
        sys.stdout.write(stdout + ("" if stdout.endswith("\n") else "\n"))
    if stderr:
        sys.stderr.write(stderr + ("" if stderr.endswith("\n") else "\n"))
    return code


def _trusted_docker_binary(
    target: Path, candidates: Sequence[Path] | None = None,
) -> Path | None:
    """Resolve Docker only from reviewed host locations, never ambient PATH."""
    trusted_target = target.resolve(strict=True)
    reviewed = candidates or (
        Path("/usr/bin/docker"),
        Path("/usr/local/bin/docker"),
        Path("/opt/homebrew/bin/docker"),
        Path("/Applications/Docker.app/Contents/Resources/bin/docker"),
    )
    for candidate in reviewed:
        try:
            resolved = candidate.resolve(strict=True)
            resolved.relative_to(trusted_target)
        except ValueError:
            if resolved.is_file() and os.access(resolved, os.X_OK):
                return resolved
        except OSError:
            continue
    return None


def _scan(args: argparse.Namespace, version: str) -> int:
    try:
        target = args.target.resolve(strict=True)
        if args.target.is_symlink() or not target.is_dir():
            raise PortableExecutionError("scan target must be a regular directory")
        managed = args.install_tools or args.cache_dir is not None
        if args.install_tools and args.tool_dir is not None:
            raise PortableExecutionError("--install-tools cannot be combined with --tool-dir")
        selected_platform = platform_id()
        cache_home = (args.cache_dir or default_cache_home()).expanduser().resolve()
        if managed:
            try:
                cache_home.relative_to(target)
            except ValueError:
                pass
            else:
                raise PortableExecutionError("managed cache must be outside the application repository")
            if args.install_tools:
                planned_reuse = inspect_profile_cache(
                    metadata_path=ROOT / "config/tools.json", cache_home=cache_home,
                    version=version, platform_name=selected_platform, profile=args.profile,
                )
                for line in managed_toolchain_disclosure(
                    profile=args.profile, platform_name=selected_platform,
                    cache_home=cache_home, cache_reused=planned_reuse,
                    network_mode=args.network_mode,
                ):
                    _progress(line)
                tool_dir, cache_reused = install_profile_tools(
                    metadata_path=ROOT / "config/tools.json", cache_home=cache_home,
                    version=version, platform_name=selected_platform, profile=args.profile,
                    progress=_progress,
                )
            else:
                tool_dir = validate_profile_tools(
                    metadata_path=ROOT / "config/tools.json", cache_home=cache_home,
                    version=version, platform_name=selected_platform, profile=args.profile,
                )
                cache_reused = True
                _progress(f"Reusing verified {args.profile} toolchain cache")
            results = (
                args.results.expanduser().resolve()
                if args.results is not None
                else prepare_managed_results_dir(cache_home, target)
            )
            try:
                results.relative_to(target)
            except ValueError:
                pass
            else:
                raise PortableExecutionError("managed results must be outside the application repository")
        else:
            cache_reused = False
            results = (args.results or Path("results")).resolve()
            tool_dir = (args.tool_dir or ROOT / ".tools/bin").resolve()
        decision = select_execution_mode(
            requested=args.execution_mode, profile=args.profile, current_platform=selected_platform,
            tool_dir=tool_dir, support=load_support(ROOT / "config/portable-execution.json"),
        )
        if decision.selected_mode != "native":
            raise PortableExecutionError("container profile runner is not available in this release")
        blocked_scanner_environment = (
            "ACTIONLINT_", "CHECKOV_", "GITLEAKS_", "OPENGREP_", "OSV_SCANNER_",
            "SEMGREP_", "SYFT_", "TRIVY_",
        )
        environment = (
            {
                key: value for key, value in os.environ.items()
                if not key.startswith(blocked_scanner_environment)
            }
            if managed else dict(os.environ)
        )
        environment["VIBESEC_TOOL_DIR"] = str(tool_dir)
        environment["VIBESEC_NETWORK_MODE"] = args.network_mode
        if managed:
            environment.pop("VIBESEC_DOCKER_BIN", None)
            safe_path = [str(tool_dir), str(Path(sys.executable).resolve().parent), "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
            environment["PATH"] = os.pathsep.join(dict.fromkeys(safe_path))
            if args.profile == "standard":
                docker = _trusted_docker_binary(target)
                if docker:
                    environment["VIBESEC_DOCKER_BIN"] = str(docker)
            environment["VIBESEC_MANAGED_MODE"] = "1"
        command = (["/bin/bash", str(ROOT / "scripts/run_minimal_profile.sh"), str(target), str(results), str(ROOT)]
                   if args.profile == "minimal" else
                   [sys.executable, str(ROOT / "scripts/run_standard_profile.py"), str(target), str(results),
                    "--vibesec-root", str(ROOT), "--tool-dir", str(tool_dir),
                    "--network-mode", args.network_mode])
        code, _stdout, _stderr = _run(command, environment=environment, working_directory=target)
        status = "success" if code == 0 else "policy_violation" if code == 1 else "tool_error" if code == 2 else "invalid_input"
        emit(envelope(
            "scan", version, status, result={
                **decision.result(), "target_name": target.name, "results": str(results),
                "exit_code": code, "managed_tools": managed, "cache_reused": cache_reused,
                "network_mode": args.network_mode,
            },
            errors=([f"scanner orchestration returned exit code {code}; inspect only the sanitized result artifacts"] if code else []),
            information=([
                "Standard online mode may send package identifiers, versions, ecosystems, and file hashes to OSV.dev or deps.dev."
            ] if args.profile == "standard" and args.network_mode == "online" else []),
        ), as_json=args.json)
        return code
    except ToolchainError as exc:
        emit(envelope("scan", version, "tool_error", errors=[str(exc)]), as_json=args.json)
        return VERIFICATION_FAILED
    except (OSError, PortableExecutionError) as exc:
        emit(envelope("scan", version, "invalid", errors=[str(exc)]), as_json=args.json)
        return INVALID_INPUT
    except subprocess.TimeoutExpired:
        emit(envelope("scan", version, "tool_error", errors=["scan exceeded the bounded runtime"]), as_json=args.json)
        return VERIFICATION_FAILED


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    scan = subcommands.add_parser("scan")
    scan.add_argument("--target", type=Path, default=Path("."))
    scan.add_argument("--results", type=Path)
    scan.add_argument("--profile", choices=("minimal", "standard"), default="minimal")
    scan.add_argument("--execution-mode", choices=("native", "container", "auto"), default="auto")
    scan.add_argument("--tool-dir", type=Path)
    scan.add_argument("--install-tools", action="store_true")
    scan.add_argument("--cache-dir", type=Path)
    scan.add_argument("--network-mode", choices=("online", "offline"), default="online")
    scan.add_argument("--json", action="store_true")
    for name in ("doctor", "verify"):
        command = subcommands.add_parser(name)
        command.add_argument("--target", type=Path, default=Path("."))
        command.add_argument("--json", action="store_true")
        if name == "doctor":
            command.add_argument("--profile", choices=("minimal", "standard"))
    initialize = subcommands.add_parser("init")
    initialize.add_argument("arguments", nargs=argparse.REMAINDER)
    upgrade = subcommands.add_parser("upgrade-plan")
    upgrade.add_argument("--target", type=Path, required=True)
    upgrade.add_argument("--bundle", type=Path, required=True)
    upgrade.add_argument("--json", action="store_true")
    extensions = subcommands.add_parser("extensions")
    extensions.add_argument("arguments", nargs=argparse.REMAINDER)
    agents = subcommands.add_parser("agents")
    agents.add_argument("arguments", nargs=argparse.REMAINDER)
    return parser


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "init":
        try:
            return _passthrough("init_vibesec.py", sys.argv[2:])
        except (OSError, subprocess.TimeoutExpired) as exc:
            emit(envelope("init", "unknown", "infrastructure_failure", errors=[type(exc).__name__]), as_json=False)
            return INFRASTRUCTURE_FAILURE
    args = build_parser().parse_args()
    try:
        version = read_version(ROOT)
    except VersionError:
        version = "unknown"
    try:
        if args.command == "scan":
            return _scan(args, version)
        if args.command == "doctor":
            command = ["--target", str(args.target)] + (["--profile", args.profile] if args.profile else []) + (["--json"] if args.json else [])
            return _passthrough("vibesec_doctor.py", command)
        if args.command == "verify":
            return _passthrough("verify_installation.py", ["--target", str(args.target)] + (["--json"] if args.json else []))
        if args.command == "init":
            return _passthrough("init_vibesec.py", args.arguments)
        if args.command == "upgrade-plan":
            return _passthrough("plan_vibesec_upgrade.py", ["--target", str(args.target), "--bundle", str(args.bundle)] + (["--json"] if args.json else []))
        if args.command == "extensions":
            return _passthrough("manage_extensions.py", args.arguments)
        return _passthrough("manage_agents.py", args.arguments)
    except (OSError, subprocess.TimeoutExpired) as exc:
        emit(envelope(args.command, version, "infrastructure_failure", errors=[type(exc).__name__]), as_json=getattr(args, "json", False))
        return INFRASTRUCTURE_FAILURE


if __name__ == "__main__":
    raise SystemExit(main())
